# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# large files
node_modules.zip
public/maps/Shapefiles/hotosm_pak_roads_lines_shp.*
public/maps/Shapefiles/hotosm_pak_waterways_lines_shp.*
public/maps/Shapefiles/hotosm_pak_waterways_lines_shpCopy.*

# KMZ files (too large for GitHub) — except Paroa/Domel packs (small; required for KMZ GIS API routes on Vercel)
public/maps/kmz/**/*.kmz
!public/maps/kmz/Paroa_kmz_gis_maps/
!public/maps/kmz/Paroa_kmz_gis_maps/**/*.kmz
!public/maps/kmz/Domel_kmz_gis_maps/
!public/maps/kmz/Domel_kmz_gis_maps/**/*.kmz
!public/maps/kmz/Kakki_kmz_gis_maps/
!public/maps/kmz/Kakki_kmz_gis_maps/**/*.kmz
!public/maps/kmz/Paharpur_kmz_gis_maps/
!public/maps/kmz/Paharpur_kmz_gis_maps/**/*.kmz

# Generated GIS data (converted from shapefiles)
/gis-data/
